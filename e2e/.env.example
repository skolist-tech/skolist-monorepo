# ============================================================
# E2E Test Environment Variables
# Copy this file to .env and fill in your local values.
# ============================================================

# Frontend URL (ai_paper_generator dev server)
BASE_URL=http://localhost:3001

# Backend API URL (FastAPI / uvicorn)
API_URL=http://localhost:8080

# Supabase (from `supabase status` after running `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Test user credentials (must match a seeded auth user, e.g. python_seeds/001_seed_users.py)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password123
