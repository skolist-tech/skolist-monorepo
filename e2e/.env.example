# ============================================================
# E2E Test Environment Variables
# Copy this file to .env and fill in your local values.
# ============================================================

# Frontend URL (ai_paper_generator / qgen)
BASE_URL=http://localhost:3001

# Assessments app (frontend/apps/assessments)
ASSESSMENTS_BASE_URL=http://localhost:3003

# Backend API URL (FastAPI / uvicorn)
API_URL=http://localhost:8080

# Supabase (from `supabase status` after running `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# QGEN login smoke user (python_seeds / integration tests)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=password123

# Assessment seed users (python_seeds/data/_002_data_user.py)
ASSESSMENT_PASSWORD=password123
ASSESSMENT_TEACHER_EMAIL=teacher1@seed.skolist.com
ASSESSMENT_STUDENT_EMAIL=student1@seed.skolist.com

# Record Playwright videos into e2e/videos/ (or use npm run test:headed:video)
# E2E_VIDEO=1
