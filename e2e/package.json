{
  "name": "@skolist/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end tests for Skolist (Playwright)",
  "scripts": {
    "playwright": "BROWSERSLIST_IGNORE_OLD_DATA=1 NODE_OPTIONS='--disable-warning=DEP0205' playwright",
    "test": "npm run playwright -- test",
    "test:headed": "npm run playwright -- test --headed --workers=1",
    "test:headed:video": "E2E_VIDEO=1 npm run playwright -- test --headed --workers=1",
    "test:headed:video:images": "E2E_VIDEO=1 E2E_IMAGES=1 npm run playwright -- test --headed --workers=1",
    "test:qgen": "npm run playwright -- test --project=qgen",
    "test:assessments": "npm run playwright -- test --project=assessments --workers=1",
    "test:assessments:teacher": "npm run playwright -- test --project=assessments --workers=1 tests/assessment_api/teachers",
    "test:assessments:student": "npm run playwright -- test --project=assessments --workers=1 tests/assessment_api/students",
    "test:assessments:headed": "npm run playwright -- test --project=assessments --headed --workers=1",
    "test:assessments:headed:video": "E2E_VIDEO=1 npm run playwright -- test --project=assessments --headed --workers=1",
    "test:assessments:headed:video:images": "E2E_VIDEO=1 E2E_IMAGES=1 npm run playwright -- test --project=assessments --headed --workers=1",
    "test:browser": "npm run playwright -- test --config=playwright.browser-check.config.ts --headed --workers=1",
    "test:ui": "npm run playwright -- test --ui",
    "codegen": "npm run playwright -- codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.2.3",
    "dotenv": "^16.5.0",
    "typescript": "^5.9.3"
  }
}
