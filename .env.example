# ALL ENVIRONMENT VARIABLES


# VITE ENVIRONMENT VARIABLES FOR REACT+VITE PROJECTS

# SUPABASE CONFIGURATIONS
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FOR Auth
# In production, set to .skolist.com to share auth across subdomains
# In development, leave empty or set to localhost
VITE_COOKIE_DOMAIN=
# TRUE / FALSE
VITE_PHONE_SMS_AVAILABLE=

# App URLs (used for OAuth redirects)
VITE_LANDING_URL=
VITE_QGEN_URL=
VITE_TUTOR_URL=

# FIREBASE CONFIGURATIONS
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# BACKEND CONFIGURATIONS
VITE_FASTAPI_URL =

# OTHERS
# LOCAL / PRODUCTION
VITE_DEPLOYMENT_ENV=


